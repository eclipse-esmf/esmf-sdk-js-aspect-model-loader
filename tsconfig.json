{
    "compileOnSave": false,
    "compilerOptions": {
        "types": ["node"],
        "rootDir": "./src",
        "outDir": "./dist",
        "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "useDefineForClassFields": false,
        "strict": true,
        "esModuleInterop": true,
        "importHelpers": true,
        "isolatedModules": true,
        "removeComments": true
    },
    "exclude": ["node_modules"],
    "include": ["src/**/*"]
}
