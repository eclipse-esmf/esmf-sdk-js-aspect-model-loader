{
  "name": "@esmf/sdk-js",
  "version": "4.0.0",
  "description": "ESMF JavaScript SDK: load, instantiate and traverse SAMM Aspect Models natively in JavaScript and TypeScript",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && tsc --build tsconfig.json",
    "prettier": "prettier --config .prettierrc --write \"./{src,test}/**/*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:prettier": "prettier --config .prettierrc --check \"./{src,test}/**/*.ts\"",
    "test:coverage": "vitest run --coverage",
    "docs:api": "typedoc",
    "check:package": "publint && attw --pack . --profile esm-only",
    "all": "pnpm run build && pnpm run prettier && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run check:package"
  },
  "files": [
    "dist/**",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "keywords": [
    "DTS",
    "Digital Twin System",
    "Twin",
    "Digital Twin",
    "Aspect Meta Model",
    "SAMM",
    "ESMF",
    "Aspect Model",
    "SDK"
  ],
  "homepage": "https://github.com/eclipse-esmf/esmf-sdk-js-aspect-model-loader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eclipse-esmf/esmf-sdk-js-aspect-model-loader.git"
  },
  "bugs": {
    "url": "https://github.com/eclipse-esmf/esmf-sdk-js-aspect-model-loader/issues"
  },
  "author": "Eclipse Semantic Modeling Framework",
  "license": "mpl-2.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/n3": "^1.26.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "rimraf": "^6.1.4",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "locale-codes": "^2.0.0",
    "n3": "^2.13.12",
    "rxjs": "^7.8.2"
  },
  "packageManager": "pnpm@12.21.0"
}
